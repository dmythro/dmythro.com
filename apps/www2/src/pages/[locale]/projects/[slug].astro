---
import { getEntry, render } from 'astro:content'
import { BASE_URL, USERNAME } from '@dmythro/constants'
import { Camera, ExternalLink, Globe, Music, Package, Terminal } from '@lucide/astro'
import type { MarkdownHeading } from 'astro'
import { Github } from 'simple-icons-astro'
import ArticleToc from '@/components/ArticleToc.astro'
import BackLink from '@/components/BackLink.astro'
import InstallCommand from '@/components/InstallCommand.astro'
import * as mdxComponents from '@/components/mdx'
import ProjectCard from '@/components/ProjectCard.astro'
import ProjectMeta from '@/components/ProjectMeta.astro'
import ProjectStatusBadge from '@/components/ProjectStatusBadge.astro'
import StatBadge from '@/components/StatBadge.astro'
import TagBadge from '@/components/TagBadge.astro'
import { getProjectAuthors, getProjectUrl, getRelatedProjects, projects } from '@/data/projects'
import PageLayout from '@/layouts/PageLayout.astro'
import { fetchGithubStats } from '@/utils/fetchGithubStats'
import { fetchNpmStats } from '@/utils/fetchNpmStats'
import { toIsoDate } from '@/utils/formatDate'
import { getT } from '@/utils/getT'
import { availableLocales, type LocaleCode } from '@/utils/i18n'
import { projectOgImagePath } from '@/utils/ogImage'

export function getStaticPaths() {
  return projects.flatMap((project) =>
    availableLocales.map((locale) => ({
      params: { locale, slug: project.slug },
      props: { project },
    })),
  )
}

const { locale, slug } = Astro.params as { locale: LocaleCode; slug: string }
const { project } = Astro.props
const t = getT(locale)
const title = project.title[locale]
const description = project.description[locale]

const projectUrl = getProjectUrl(project, locale)

// Fetch stats at build time (parallel)
const [npmStats, githubStats] = await Promise.all([
  project.npm ? fetchNpmStats(project.npmForDownloads ?? project.npm) : null,
  project.github ? fetchGithubStats(project.github, project.fallbackStars) : null,
])

// Load project article content
const articleEntry = await getEntry('projectArticles', `${slug}.${locale}`)
const rendered = articleEntry ? await render(articleEntry) : null
const ArticleContent = rendered?.Content ?? null
const headings: MarkdownHeading[] = rendered?.headings ?? []

/** Below three top-level sections a sidebar costs more attention than it saves. */
const showToc = headings.filter((heading) => heading.depth === 2).length >= 3

const iconMap = {
  package: Package,
  globe: Globe,
  terminal: Terminal,
  music: Music,
  camera: Camera,
} as const
const IconComponent = iconMap[project.icon as keyof typeof iconMap]

const ogImage = projectOgImagePath(project.slug, locale)
const publishedTime = toIsoDate(project.publishedAt)
const modifiedTime = project.updatedAt ? toIsoDate(project.updatedAt) : undefined

const toPersonNode = (credit: { name: string; url?: string }) => ({
  '@type': 'Person' as const,
  name: credit.name,
  ...(credit.url && { url: credit.url }),
})

const projectJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareSourceCode',
      name: title,
      description,
      url: `${BASE_URL}/${locale}/projects/${project.slug}`,
      image: `${BASE_URL}${ogImage}`,
      inLanguage: locale,
      datePublished: publishedTime,
      ...(modifiedTime && { dateModified: modifiedTime }),
      author: getProjectAuthors(project).map(toPersonNode),
      ...(project.contributors?.length && {
        contributor: project.contributors.map(toPersonNode),
      }),
      ...(project.organization && {
        publisher: {
          '@type': 'Organization',
          name: project.organization.name,
          ...(project.organization.url && { url: project.organization.url }),
        },
      }),
      ...(project.uses?.length && {
        isBasedOn: project.uses.map((tool) => ({
          '@type': 'SoftwareApplication',
          name: tool.name,
          ...(tool.url && { url: tool.url }),
        })),
      }),
      keywords: project.tags.join(', '),
      ...(project.github && { codeRepository: `https://github.com/${project.github}` }),
      ...(projectUrl && { sameAs: projectUrl }),
      ...(project.programmingLanguages?.length && {
        programmingLanguage:
          project.programmingLanguages.length === 1
            ? project.programmingLanguages[0]
            : project.programmingLanguages,
      }),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t.nav.home, item: `${BASE_URL}/${locale}` },
        {
          '@type': 'ListItem',
          position: 2,
          name: t.projects.title,
          item: `${BASE_URL}/${locale}/projects`,
        },
        { '@type': 'ListItem', position: 3, name: title },
      ],
    },
  ],
}

// Related projects for cross-linking
const relatedWithStats = await Promise.all(
  getRelatedProjects(project).map(async (p) => ({
    project: p,
    npm: p.npm ? await fetchNpmStats(p.npmForDownloads ?? p.npm) : null,
    github: p.github ? await fetchGithubStats(p.github, p.fallbackStars) : null,
  })),
)
---

<PageLayout
  locale={locale}
  title={`${title} — ${t.projects.title} — ${USERNAME}`}
  description={description}
  jsonLd={projectJsonLd}
  ogImage={ogImage}
  ogType="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
>
  {/* Content fills the column and the sidebar sits beside it, matching the CV. The
      group used to be centred with a reading-width cap, which started the article
      109px right of the gutter every other page uses — visible as a jump mid-morph,
      since the title view-transitions in from the card. */}
  <div class:list={[showToc && 'flex gap-8 lg:gap-12']}>
    <div class="flex-1 min-w-0 order-1">
      <article>
        <header id="top" class="mb-6 scroll-mt-20">
          <div class="flex items-center gap-1 mb-2">
            <BackLink href={`/${locale}/projects`} label={t.nav.projects} />
            <h1 class="text-3xl font-bold flex items-center gap-2">
              {IconComponent && <IconComponent class="h-7 w-7 shrink-0 opacity-60" />}
              <span class="mr-2" transition:name={`project-title-${project.slug}`}>{title}</span>
              {projectUrl && (
                <a href={projectUrl} class="tooltip tooltip-bottom tooltip-primary" data-tip={t.projects.visitSite} aria-label={t.projects.visitSite} target="_blank" rel="noopener noreferrer">
                  <ExternalLink class="h-5 w-5 opacity-50 hover:opacity-100 transition-opacity" />
                </a>
              )}
              {project.github && (
                <a href={`https://github.com/${project.github}`} class="tooltip tooltip-bottom tooltip-primary" data-tip="GitHub" aria-label="GitHub repository" target="_blank" rel="noopener noreferrer">
                  <Github class="h-5 w-5 opacity-50 hover:opacity-100 transition-opacity" />
                </a>
              )}
              {project.npm && (
                <a href={`https://www.npmjs.com/package/${project.npm}`} class="tooltip tooltip-bottom tooltip-primary" data-tip="NPM" aria-label="NPM package" target="_blank" rel="noopener noreferrer">
                  <Package class="h-5 w-5 opacity-50 hover:opacity-100 transition-opacity" />
                </a>
              )}
            </h1>
          </div>
          <p class="text-base-content/60 mb-4">{description}</p>

          <div class="flex flex-wrap items-center gap-1 mb-4">
            <ProjectStatusBadge status={project.status} locale={locale} />
            {npmStats && npmStats.downloads > 0 && <StatBadge type="npm" value={npmStats.downloads} />}
            {githubStats && githubStats.stars > 0 && <StatBadge type="stars" value={githubStats.stars} />}
            {project.tags.map((tag) => <TagBadge tag={tag} />)}
          </div>

          {(project.installPackage || project.installRunner || project.install) && (
            <div class="my-6">
              <InstallCommand
                package={project.installPackage}
                runner={project.installRunner}
                command={project.install}
                locale={locale}
              />
            </div>
          )}
        </header>

        {ArticleContent && (
          <div class="prose max-w-none mt-6">
            <ArticleContent components={mdxComponents} />
          </div>
        )}

        <ProjectMeta project={project} locale={locale} />
      </article>

      {/* Related projects */}
      {relatedWithStats.length > 0 && (
        <section class="mt-12">
          <h2 class="text-2xl font-semibold mb-4">
            {t.projects.otherProjects}
          </h2>
          <ul class="grid grid-cols-1 sm:grid-cols-3 gap-4 items-start">
            {relatedWithStats.map(({ project: p, npm, github }) => (
              <li class="h-full">
                <ProjectCard project={p} locale={locale} npm={npm} github={github} />
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>

    {/* After the article in DOM order so assistive tech and print reach the
        content first; `order-2` places it on the right visually. */}
    {showToc && (
      <aside
        class="hidden md:block w-[250px] shrink-0 sticky top-20 self-start order-2 max-h-[calc(100dvh-6rem)] overflow-y-auto overscroll-contain print:hidden"
      >
        <ArticleToc
          headings={headings}
          label={t.projects.onThisPage}
          topLabel={t.projects.backToTop}
        />
      </aside>
    )}
  </div>
</PageLayout>
