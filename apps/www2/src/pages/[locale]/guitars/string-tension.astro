---

import { BASE_URL, USERNAME } from '@dmythro/constants'
import { StringTensionCalculator } from '@/components/islands/StringTensionCalculator'
import PageHeader from '@/components/PageHeader.astro'
import PageLayout from '@/layouts/PageLayout.astro'
import { getT } from '@/utils/getT'
import { getStaticLocalePaths, type LocaleCode } from '@/utils/i18n'
import { pageOgImagePath } from '@/utils/ogImage'

export function getStaticPaths() {
  return getStaticLocalePaths()
}

const { locale } = Astro.params as { locale: LocaleCode }
const t = getT(locale)
const st = t.guitars.stringTension

const calcJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: st.title,
  description: st.description,
  url: `${BASE_URL}/${locale}/guitars/string-tension`,
  applicationCategory: 'UtilityApplication',
  author: { '@type': 'Person', name: 'Dmytro Klymenko', url: BASE_URL },
}
---

<PageLayout locale={locale} title={`${st.title} — ${USERNAME}`} description={st.description} jsonLd={calcJsonLd} ogImage={pageOgImagePath('stringTension', locale)}>
  <PageHeader title={st.title} subtitle={st.description} />

  <StringTensionCalculator client:load translations={st} />

  {/* The tool answers "what tension"; the project page answers "why that number",
      which is a different visit. Kept to a footnote so it does not compete with
      the calculator for the reader arriving to use it. */}
  <p class="mt-4 text-sm text-base-content/60">
    {st.aboutNote}{' '}
    <a href={`/${locale}/projects/string-tension`} class="link link-primary">{st.aboutLink}</a>
  </p>
</PageLayout>
