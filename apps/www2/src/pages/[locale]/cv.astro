---
import { statSync } from 'node:fs'
import { fileURLToPath } from 'node:url'
import { BASE_URL, ESocialLinks, USERNAME } from '@dmythro/constants'
import { FileDown } from '@lucide/astro'
import CvArticle from '@/components/CvArticle.astro'
import CvToc from '@/components/CvToc.astro'
import PageHeader from '@/components/PageHeader.astro'
import PhotoCard from '@/components/PhotoCard.astro'
import PageLayout from '@/layouts/PageLayout.astro'
import { formatFileSize } from '@/utils/formatSize'
import { getT } from '@/utils/getT'
import { getStaticLocalePaths, type LocaleCode } from '@/utils/i18n'
import { pageOgImagePath } from '@/utils/ogImage'

export function getStaticPaths() {
  return getStaticLocalePaths()
}

const { locale } = Astro.params as { locale: LocaleCode }
const t = getT(locale)
const years = new Date().getFullYear() - 2006
const cvDescription = t.cv.description(years).join(' ')

// Measured from the file that ships, so the figure cannot drift from the download.
const pdfPath = `/cv.${locale}.pdf`
const pdfSize = formatFileSize(
  statSync(fileURLToPath(new URL(`../../../public${pdfPath}`, import.meta.url))).size,
  locale,
)
const downloadLabel = t.actions.downloadPdfTooltip(pdfSize)

const cvJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: t.fullName,
    url: BASE_URL,
    jobTitle: 'Principal Engineer / Tech Lead',
    sameAs: [
      ESocialLinks.github,
      ESocialLinks.linkedin,
      ESocialLinks.bluesky,
      ESocialLinks.threads,
      ESocialLinks.twitter,
    ],
  },
}
---

<PageLayout
  locale={locale}
  title={`CV: ${t.fullName} — ${USERNAME}`}
  description={cvDescription}
  jsonLd={cvJsonLd}
  ogImage={pageOgImagePath('cv', locale)}
>
  <div class="flex gap-8 lg:gap-12 print:block">
    {/* Main content */}
    {/* Fills the column — the CV is grids, timelines and cards rather than long
        prose, so it does not need an article's reading-width cap. */}
    <div class="flex-1 min-w-0 print:block">
      {/* Print-only photo */}
      <div class="hidden print:block print:max-w-[60%] print:mx-auto print:mb-6">
        <PhotoCard locale={locale} />
      </div>

      {/* Screen only: on paper the photo block above already carries the name, so a
          "CV — name" heading and its tagline are just noise at the top of page one. */}
      <div class="no-print">
        <PageHeader title={`CV — ${t.fullName}`} subtitle={t.meta.descriptionShort}>
          <div
            slot="actions"
            class="tooltip tooltip-left tooltip-primary"
            data-tip={downloadLabel}
          >
            <a
              href={pdfPath}
              class="btn btn-ghost btn-sm btn-square"
              download
              data-cv-download={locale}
              aria-label={downloadLabel}
            >
              <FileDown class="h-5 w-5" />
            </a>
          </div>
        </PageHeader>
      </div>

      <CvArticle locale={locale} />
    </div>

    {/* Sticky sidebar: photo, PDF download, ToC — after the content in DOM
        order so screen readers and print reach the CV itself first. `md`, not
        `lg`: the sidebar is the only place the PDF link renders, so tablets
        must keep it. */}
    <aside
      class="hidden md:block w-[250px] shrink-0 sticky top-20 self-start max-h-[calc(100dvh-6rem)] overflow-y-auto overscroll-contain print:hidden"
      aria-label="CV sidebar"
    >
      <PhotoCard locale={locale} />
      <div class="mt-6">
        <CvToc locale={locale} />
      </div>
    </aside>
  </div>
  <script>
    function setupCvTracking() {
      const downloadLink = document.querySelector<HTMLAnchorElement>('[data-cv-download]')
      if (downloadLink) {
        downloadLink.addEventListener('click', () => {
          window.zaraz?.track('cv_download', { locale: downloadLink.dataset.cvDownload })
        })
      }

      window.addEventListener('beforeprint', () => {
        window.zaraz?.track('cv_print')
      })
    }

    document.addEventListener('astro:page-load', setupCvTracking)
  </script>
</PageLayout>
