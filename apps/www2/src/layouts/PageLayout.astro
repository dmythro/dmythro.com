---
import Footer from '@/components/Footer.astro'
import TopNavbar from '@/components/TopNavbar.astro'
import type { LocaleCode } from '@/utils/i18n'
import { contentWidth, pagePadding } from '@/utils/layout'
import BaseLayout from './BaseLayout.astro'

interface Props {
  locale: LocaleCode
  title: string
  description: string
  jsonLd?: Record<string, unknown>
  ogImage?: string
  ogType?: 'website' | 'article'
  publishedTime?: string
  modifiedTime?: string
  isHeroPage?: boolean
}

const {
  locale,
  title,
  description,
  jsonLd,
  ogImage,
  ogType,
  publishedTime,
  modifiedTime,
  isHeroPage = false,
} = Astro.props
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  jsonLd={jsonLd}
  ogImage={ogImage}
  ogType={ogType}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
>
  <slot name="head" slot="head" />

  {isHeroPage ? (
    <slot name="hero" />
    <main transition:animate="none">
      <slot />
    </main>
  ) : (
    <>
      <TopNavbar locale={locale} />
      <main class:list={[pagePadding, 'py-6']} transition:animate="none">
        <div class={contentWidth}>
          <slot />
        </div>
      </main>
    </>
  )}

  <style is:global>
    /* Snappy by default. Project titles use a per-slug name (`project-title-*`)
       that CSS cannot enumerate, so the wildcard covers them; the named rules
       below are more specific and still win. */
    ::view-transition-group(*) {
      animation-duration: 150ms;
      animation-timing-function: ease-out;
    }

    ::view-transition-group(navbar) {
      animation: none;
      z-index: 50;
    }

    ::view-transition-group(page-title) {
      animation-duration: 150ms;
      animation-timing-function: ease-in-out;
    }

    @media (prefers-reduced-motion: reduce) {
      ::view-transition-group(*),
      ::view-transition-old(*),
      ::view-transition-new(*) {
        animation: none !important;
        animation-duration: 0s !important;
      }
    }
  </style>

  <div transition:animate="none">
    <Footer locale={locale} />
  </div>
</BaseLayout>
