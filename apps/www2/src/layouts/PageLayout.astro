---
import Footer from '@/components/Footer.astro'
import TopNavbar from '@/components/TopNavbar.astro'
import type { PreloadFace } from '@/utils/fontPreloads'
import type { LocaleCode } from '@/utils/i18n'
import { contentWidth, pagePadding } from '@/utils/layout'
import BaseLayout from './BaseLayout.astro'

interface Props {
  locale: LocaleCode
  title: string
  description: string
  jsonLd?: Record<string, unknown>
  ogImage?: string
  ogType?: 'website' | 'article'
  publishedTime?: string
  modifiedTime?: string
  isHeroPage?: boolean
  preloadFonts?: PreloadFace[]
}

const {
  locale,
  title,
  description,
  jsonLd,
  ogImage,
  ogType,
  publishedTime,
  modifiedTime,
  isHeroPage = false,
  preloadFonts,
} = Astro.props
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  jsonLd={jsonLd}
  ogImage={ogImage}
  ogType={ogType}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  preloadFonts={preloadFonts}
>
  <slot name="head" slot="head" />

  {isHeroPage ? (
    <slot name="hero" />
    <main>
      <slot />
    </main>
  ) : (
    <>
      <TopNavbar locale={locale} />
      <main class:list={[pagePadding, 'py-6']}>
        <div class={contentWidth}>
          <slot />
        </div>
      </main>
    </>
  )}

  <Footer locale={locale} />
</BaseLayout>
