---
import { ClientRouter } from 'astro:transitions'
import { BASE_URL, USERNAME } from '@dmythro/constants'
import { availableLocales, cleanPathname, type LocaleCode } from '@/utils/i18n'
import '@/styles/global.css'

interface Props {
  locale: LocaleCode
  title: string
  description: string
  jsonLd?: Record<string, unknown>
  /** Site-root-relative path to a page-specific OG image. Defaults to the avatar card. */
  ogImage?: string
  /** `article` for project pages, so social cards and crawlers treat them as content. */
  ogType?: 'website' | 'article'
  /** ISO dates surfaced as `article:*` meta when `ogType` is `article`. */
  publishedTime?: string
  modifiedTime?: string
}

const {
  locale,
  title,
  description,
  jsonLd,
  ogImage,
  ogType = 'website',
  publishedTime,
  modifiedTime,
} = Astro.props
const pathname = cleanPathname(Astro.url.pathname)
const canonicalUrl = new URL(pathname, BASE_URL)
const ogImageUrl = `${BASE_URL}${ogImage ?? '/avatar@og.jpg'}`
const ogImageType = ogImageUrl.endsWith('.png') ? 'image/png' : 'image/jpeg'
---

{/* Smooth scrolling is production-only: dev HMR re-renders restore the scroll
    position, and animating that jump on every edit is maddening. */}
<html lang={locale} data-theme="light" class:list={[import.meta.env.PROD && 'scroll-smooth']}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />

    <title>{title}</title>
    <meta name="description" content={description} />

    {/* Open Graph */}
    <meta property="og:title" content={title} />
    <meta property="og:site_name" content="dmythro.com" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content={ogImageType} />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    <meta property="og:locale" content={locale === 'uk' ? 'uk_UA' : 'en_US'} />
    {availableLocales.filter((l) => l !== locale).map((l) => (
      <meta property="og:locale:alternate" content={l === 'uk' ? 'uk_UA' : 'en_US'} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@dmythro" />
    <meta name="twitter:creator" content="@dmythro" />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="canonical" href={canonicalUrl.href} />
    {availableLocales.map((l) => (
      <link
        rel="alternate"
        hreflang={l}
        href={`${BASE_URL}/${l}${pathname.replace(`/${locale}`, '')}`}
      />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${BASE_URL}/en${pathname.replace(`/${locale}`, '')}`} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />
    {availableLocales.map((l) => (
      <>
        <link
          rel="alternate"
          type="application/rss+xml"
          href={`${BASE_URL}/${l}/rss.xml`}
          title={`${USERNAME} — ${l.toUpperCase()}`}
          hreflang={l}
        />
        <link
          rel="alternate"
          type="application/feed+json"
          href={`${BASE_URL}/${l}/feed.json`}
          title={`${USERNAME} — ${l.toUpperCase()} (JSON Feed)`}
          hreflang={l}
        />
      </>
    ))}

    <ClientRouter />

    {/* Safari: skip view transition animations (snapshot step causes stutter) */}
    <script is:inline>
      if (/^((?!chrome|android).)*safari/i.test(navigator.userAgent)) {
        document.addEventListener('astro:before-swap', (e) => {
          const vt = e.viewTransition
          if (!vt) return
          // Per spec skipTransition() rejects `ready` with an AbortError, and Astro's
          // router only ever attaches handlers to updateCallbackDone and finished.
          // Without a handler here that rejection reaches the console as an unhandled
          // promise on every single navigation. Claiming it changes nothing else: this
          // derived promise is discarded, and the swap runs off the two promises Astro
          // does await. Anything that is not the AbortError we just asked for is a real
          // failure, so it still gets reported rather than swallowed — logged rather
          // than rethrown, since rethrowing would recreate the unhandled rejection.
          void vt.ready?.catch((err) => {
            if (err?.name !== 'AbortError') console.error('[view-transition]', err)
          })
          vt.skipTransition()
        })
      }
    </script>

    {/* Theme init — resolves before first paint, then keeps the theme pinned
        across View Transition swaps. `__applyTheme` is shared with ThemeToggle. */}
    <script is:inline>
      ;(() => {
        const readMode = () => {
          let mode = localStorage.getItem('theme-mode')
          if (!mode) {
            const old = localStorage.getItem('theme')
            if (old) { mode = old; localStorage.setItem('theme-mode', old); localStorage.removeItem('theme') }
            else { mode = 'system' }
          }
          return mode
        }
        const resolve = (mode) => mode === 'system'
          ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          : mode
        const paint = (root, theme) => root.setAttribute('data-theme', theme)

        // `instant` mutes transitions across the change. A theme the reader chose is
        // allowed to animate; one that merely lands during a page swap must not.
        window.__applyTheme = (mode, instant) => {
          const root = document.documentElement
          const theme = resolve(mode || readMode())
          const changed = root.getAttribute('data-theme') !== theme
          if (changed && instant) root.setAttribute('data-theme-switching', '')
          paint(root, theme)
          if (changed && instant) {
            void root.offsetHeight // commit the palette before transitions come back
            root.removeAttribute('data-theme-switching')
          }
        }

        // Nothing has painted yet, so no transition can exist to mute.
        paint(document.documentElement, resolve(readMode()))

        // Astro copies the incoming document's root attributes onto the live <html>,
        // and every page is authored as data-theme="light". Writing the real theme
        // into that document first keeps <html> from passing through the light
        // palette mid-navigation — a style flush landing in that window is what
        // made card borders animate from light to dark.
        document.addEventListener('astro:before-swap', (e) => {
          paint(e.newDocument.documentElement, resolve(readMode()))
        })
        document.addEventListener('astro:after-swap', () => window.__applyTheme(null, true))
      })()
    </script>

    {/* A lazy image below the fold was never fetched, so it prints as blank space.
        Loading is DOM state a print stylesheet cannot reach. Collapsed answers need
        no such help — print CSS opens those. */}
    <script is:inline>
      window.addEventListener('beforeprint', () => {
        for (const img of document.querySelectorAll('img[loading="lazy"]')) {
          img.loading = 'eager'
          img.fetchPriority = 'high'
        }
      })
    </script>

    {/* Disable smooth scroll during view transitions (JS fallback) */}
    <script is:inline>
      document.addEventListener('astro:before-swap', () => {
        document.documentElement.style.scrollBehavior = 'auto'
      })
      document.addEventListener('astro:after-swap', () => {
        document.documentElement.style.scrollBehavior = ''
      })
    </script>

    <slot name="head" />

    {jsonLd && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body class="min-h-screen bg-base-100 text-base-content">
    <slot />
  </body>

  {/* Global Zaraz event: social link clicks */}
  <script>
    document.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-social]')
      if (!link) return
      window.zaraz?.track('social_click', { platform: link.dataset.social })
    })
  </script>
</html>
