---
import type { SkillTime } from '@dmythro/locales'

interface Props {
  item: SkillTime
  isExpanded?: boolean
}

const { item, isExpanded } = Astro.props
---

<div class="card bg-base-100 border border-base-300 print:break-inside-avoid-page">
  <div class="card-body p-4">
    <p class="card-title grow-0 text-base print:text-sm">{item.title}</p>
    <p class="grow-0 text-sm print:text-xs text-base-content/60">{item.subtitle}</p>
    {isExpanded && (
      <p class="text-base print:text-xs mt-1">
        {Array.isArray(item.description) ? item.description.join(' ') : item.description}
      </p>
    )}
  </div>
</div>
