---
import { Image } from 'astro:assets'
import avatarLarge from '@/assets/avatar@800px.jpg'
import { getT } from '@/utils/getT'
import type { LocaleCode } from '@/utils/i18n'
import CvIntro from './CvIntro.astro'

interface Props {
  locale: LocaleCode
}

const { locale } = Astro.props
const t = getT(locale)
---

<div transition:name="cv-photo" transition:animate="none">
  <figure class="overflow-hidden">
    <Image
      src={avatarLarge}
      widths={[400, 800]}
      sizes="(max-width: 400px) 400px, 800px"
      alt={t.fullName}
      class="w-full h-auto rounded-lg"
      loading="eager"
      fetchpriority="high"
    />
    <figcaption class="text-xs text-base-content/50 text-center py-1.5">
      {t.fullName} — 📷 Alina Delyne
    </figcaption>
  </figure>

  {/* The CV page shows this on screen itself; here it is only for the printed
      copy, where it belongs under the photo. */}
  <CvIntro locale={locale} class="hidden print:block mt-4" />
</div>
