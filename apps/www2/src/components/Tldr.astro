---
import { getT } from '@/utils/getT'
import type { LocaleCode } from '@/utils/i18n'

interface Props {
  locale: LocaleCode
  class?: string
}

const { locale, class: className } = Astro.props
const t = getT(locale)
---

{/* Focusable, so a tap opens the tip on touch screens, which have no hover. */}
<abbr
  class:list={[
    'tooltip tooltip-start cursor-help underline decoration-dotted decoration-1 underline-offset-4 print:no-underline',
    className,
  ]}
  data-tip={t.landing.tldrHint}
  tabindex="0"
>{t.landing.tldr}</abbr>
