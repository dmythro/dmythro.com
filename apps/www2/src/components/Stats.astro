---
import type { SkillTime } from '@dmythro/locales'
import StatCard from './StatCard.astro'

interface Props {
  id?: string
  title?: string
  items: SkillTime[]
  isExpanded?: boolean
}

const { id, title, items, isExpanded = false } = Astro.props
---

{/* Kept on one sheet: the grid reads as a whole, and it is shorter than a page. */}
<div class="print:break-inside-avoid">
  {title && (
    <h3
      id={id}
      class:list={['font-semibold my-6 print:mt-0 print:mb-3 text-2xl print:break-after-avoid', id && 'scroll-mt-24']}
    >
      {title}
    </h3>
  )}
  <div class:list={[
    'skills-grid clear-both grid gap-4 rounded print:grid-cols-3',
    isExpanded ? 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3' : 'grid-cols-2 sm:grid-cols-3',
  ]}>
    {items.map((item) => (
      <StatCard item={item} isExpanded={isExpanded} />
    ))}
  </div>
</div>
