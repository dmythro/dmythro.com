---
import type { Project, ProjectCredit } from '@/data/projects'
import { getProjectAuthors } from '@/data/projects'
import { formatDate, toIsoDate } from '@/utils/formatDate'
import { getT } from '@/utils/getT'
import type { LocaleCode } from '@/utils/i18n'

interface Props {
  project: Project
  locale: LocaleCode
}

const { project, locale } = Astro.props
const t = getT(locale)

/**
 * Places the project is distributed through — in the "get it here" sense, not
 * commercial publishing. Rendered only when it is published somewhere beyond
 * its own website or repo, so registry-less projects skip the row entirely.
 */
const publishedVia: ProjectCredit[] =
  project.npm || project.publishedOn?.length
    ? [
        ...(project.github
          ? [{ name: 'GitHub', url: `https://github.com/${project.github}` }]
          : []),
        ...(project.npm
          ? [{ name: 'NPM', url: `https://www.npmjs.com/package/${project.npm}` }]
          : []),
        ...(project.publishedOn ?? []),
      ]
    : []

const creditRows: { label: string; credits: ProjectCredit[]; prefix?: ProjectCredit }[] = [
  { label: t.projects.meta.by, credits: getProjectAuthors(project) },
  { label: t.projects.meta.with, credits: project.contributors ?? [] },
  { label: t.projects.meta.publishedBy, credits: publishedVia, prefix: project.organization },
  { label: t.projects.meta.builtWith, credits: project.uses ?? [] },
].filter(({ credits }) => credits.length > 0)

const updated = project.updatedAt ?? project.publishedAt
---

<footer class="mt-12 border-t border-base-300 pt-6">
  <h2 class="text-sm font-semibold uppercase tracking-wide text-base-content/50 mb-3">
    {t.projects.meta.title}
  </h2>

  {/* Two-column grid: the label column sizes to the longest label and the value
      column takes the rest, so long value lists wrap within their own column
      instead of dropping onto a second row. */}
  <dl class="grid gap-x-4 gap-y-2 text-sm sm:grid-cols-[max-content_1fr]">
    {creditRows.map(({ label, credits, prefix }) => (
      <>
        <dt class="text-base-content/50">{label}</dt>
        <dd class="flex flex-wrap items-baseline gap-x-1.5 gap-y-1">
          {prefix && (
            <span class="text-base-content/80">
              {prefix.url ? (
                <a
                  href={prefix.url}
                  class="link link-hover decoration-base-content/30 underline-offset-2"
                  target={prefix.url.startsWith('http') ? '_blank' : undefined}
                  rel={prefix.url.startsWith('http') ? 'noopener noreferrer' : undefined}
                >{prefix.name}</a>
              ) : (
                prefix.name
              )}
              <span class="text-base-content/45"> {t.projects.meta.on}</span>
            </span>
          )}
          {credits.map((credit, index) => (
            <span class="text-base-content/80">
              {credit.url ? (
                <a
                  href={credit.url}
                  class="link link-hover decoration-base-content/30 underline-offset-2"
                  target={credit.url.startsWith('http') ? '_blank' : undefined}
                  rel={credit.url.startsWith('http') ? 'noopener noreferrer' : undefined}
                >{credit.name}</a>
              ) : (
                credit.name
              )}{credit.role && (
                <span class="text-base-content/45"> — {credit.role[locale]}</span>
              )}{index < credits.length - 1 && <span class="text-base-content/30">,</span>}
            </span>
          ))}
        </dd>
      </>
    ))}

    <dt class="text-base-content/50">{t.projects.meta.started}</dt>
    <dd class="text-base-content/80">
      <time datetime={toIsoDate(project.startedAt)}>{formatDate(project.startedAt, locale)}</time>
    </dd>

    <dt class="text-base-content/50">{t.projects.meta.updated}</dt>
    <dd class="text-base-content/80">
      <time datetime={toIsoDate(updated)}>{formatDate(updated, locale)}</time>
    </dd>
  </dl>
</footer>
