---
import type { TimelineItem } from '@dmythro/locales'
import { BookOpen, Circle, CircleCheck, GraduationCap } from '@lucide/astro'

interface Props {
  item: TimelineItem
  index: number
  isLast?: boolean
}

const { item, index, isLast = false } = Astro.props
const { title, subtitle, description, when, till, where, isHighlighted, isCurrent, kind } = item
const isEven = index % 2 === 0
const skip = (!when && !till) || (!title && !subtitle && !description)
const timeStr = when && till ? `${when} – ${till}` : when || till

// Ongoing reads green, notable-but-finished indigo. Spelled out rather than
// interpolated because Tailwind only scans for literal class names.
const emphasis = isCurrent
  ? { line: 'bg-success', icon: 'text-success', title: 'font-black text-success' }
  : isHighlighted
    ? { line: 'bg-primary', icon: 'text-primary', title: 'font-black text-primary' }
    : { line: 'bg-primary/30', icon: 'text-base-content/30', title: 'font-bold' }

// The tick means finished, so anything ongoing gets the unticked form.
const icons = {
  work: { done: CircleCheck, current: Circle },
  education: { done: GraduationCap, current: BookOpen },
}
const Icon = icons[kind ?? 'work'][isCurrent ? 'current' : 'done']
---

{!skip && (
  <li>
    {index > 0 && <hr class:list={[emphasis.line]} />}
    <div class="timeline-middle">
      <Icon class:list={['h-5 w-5', emphasis.icon]} />
    </div>
    {isEven ? (
      <div class="timeline-start mb-10 print:mb-4 md:text-end print:text-start print:break-after-avoid">
        <time class="font-mono italic text-sm print:text-xs text-base-content/60">{timeStr}</time>
        {title && (
          <div class:list={['text-lg print:text-base print:break-after-avoid', emphasis.title]}>
            {title}
          </div>
        )}
        {subtitle && (
          <div class="text-sm print:text-xs font-medium text-base-content/80 print:break-after-avoid">
            {subtitle}
            {where && <span class="font-light"> – {where}</span>}
          </div>
        )}
        {description && (
          <div class="text-sm print:text-xs text-base-content/60 mt-1">
            {Array.isArray(description)
              ? description.map((line) => <p class="my-1">{line}</p>)
              : description
            }
          </div>
        )}
      </div>
    ) : (
      <div class="timeline-end md:mb-10 print:mb-4 print:break-after-avoid">
        <time class="font-mono italic text-sm print:text-xs text-base-content/60">{timeStr}</time>
        {title && (
          <div class:list={['text-lg print:text-base print:break-after-avoid', emphasis.title]}>
            {title}
          </div>
        )}
        {subtitle && (
          <div class="text-sm print:text-xs font-medium text-base-content/80 print:break-after-avoid">
            {subtitle}
            {where && <span class="font-light"> – {where}</span>}
          </div>
        )}
        {description && (
          <div class="text-sm print:text-xs text-base-content/60 mt-1">
            {Array.isArray(description)
              ? description.map((line) => <p class="my-1">{line}</p>)
              : description
            }
          </div>
        )}
      </div>
    )}
    {!isLast && <hr class:list={[emphasis.line]} />}
  </li>
)}
